---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — Not Found">
  <div class="not-found">
    <div class="nf-terminal">
      <div class="terminal-bar">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="terminal-title">~/404 — bash</span>
      </div>
      <div class="terminal-body">
        <div class="nf-line"><span class="prompt">❯</span> <span class="cmd">cd {Astro.url.pathname}</span></div>
        <div class="nf-line out"><span class="err">bash: cd: {Astro.url.pathname}: No such file or directory</span></div>
        <div class="nf-line"><span class="prompt">❯</span> <span class="blink-cursor">▋</span></div>
      </div>
    </div>
    <div class="nf-code">404</div>
    <p class="nf-msg">This page doesn't exist. Not even as a side-channel.</p>
    <a href="/" class="nf-home">← back to home</a>
  </div>
</Layout>

<style>
.not-found {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  padding: 2rem;
  text-align: center;
}

.nf-terminal {
  background: var(--bg-2);
  border: 1px solid var(--border-bright);
  border-radius: var(--radius-lg);
  overflow: hidden;
  max-width: 480px;
  width: 100%;
  text-align: left;
}

.terminal-bar {
  background: var(--surface);
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 6px;
  border-bottom: 1px solid var(--border);
}

.dot { width: 10px; height: 10px; border-radius: 50%; }
.dot.red    { background: #ff5f57; }
.dot.yellow { background: #ffbd2e; }
.dot.green  { background: #28ca41; }
.terminal-title { margin-left: 8px; font-size: 11px; color: var(--text-muted); }

.terminal-body {
  padding: 1rem 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 12px;
}

.nf-line { display: flex; gap: 8px; align-items: baseline; }
.prompt { color: var(--accent); }
.cmd { color: var(--text); }
.out { padding-left: 20px; }
.err { color: #ff4d6d; }
.blink-cursor { color: var(--accent); animation: blink 1s step-end infinite; }

.nf-code {
  font-family: var(--font-display);
  font-size: 8rem;
  font-weight: 800;
  color: var(--border-bright);
  letter-spacing: -0.06em;
  line-height: 1;
}

.nf-msg {
  font-size: 13px;
  color: var(--text-muted);
  max-width: 320px;
}

.nf-home {
  font-size: 12px;
  color: var(--accent) !important;
  border: 1px solid var(--accent);
  padding: 8px 20px;
  border-radius: var(--radius);
  letter-spacing: 0.05em;
  transition: all var(--transition);
  font-family: var(--font-mono);
}

.nf-home:hover {
  background: var(--accent-dim);
  opacity: 1 !important;
}
</style>
