---
import Layout from '../layouts/Layout.astro';
---
<Layout title="CV Import — Adrian Wei Portfolio">
  <div class="admin-wrap">
    <div class="admin-header">
      <div class="admin-title">
        <span class="admin-label">// admin</span>
        <h1>CV Import Panel</h1>
      </div>
      <p class="admin-sub">Paste your LaTeX CV below. The parser will extract and preview your data in real time.</p>
    </div>

    <div class="admin-layout">
      <!-- Input -->
      <div class="panel">
        <div class="panel-header">
          <span class="panel-title">latex input</span>
          <button class="load-sample-btn" id="load-sample">load sample</button>
        </div>
        <textarea id="latex-input" class="latex-area" placeholder="Paste your .tex CV content here...&#10;&#10;\begin{document}&#10;\begin{center}&#10;  \textbf{\Huge Your Name}&#10;..."></textarea>
        <div class="panel-footer">
          <button class="parse-btn" id="parse-btn">
            <span>parse cv</span>
            <span class="parse-arrow">→</span>
          </button>
          <span class="parse-status" id="parse-status"></span>
        </div>
      </div>

      <!-- Preview -->
      <div class="panel">
        <div class="panel-header">
          <span class="panel-title">parsed output</span>
          <span class="preview-count" id="field-count">—</span>
        </div>
        <div id="preview-output" class="preview-output">
          <div class="preview-empty">
            <div class="empty-icon">{ }</div>
            <p>Paste LaTeX and click parse</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
.admin-wrap {
  min-height: 100vh;
  padding: 7rem 2rem 4rem;
  max-width: 1100px;
  margin: 0 auto;
}

.admin-header {
  margin-bottom: 2rem;
}

.admin-label {
  font-size: 11px;
  color: var(--accent-2);
  letter-spacing: 0.15em;
  font-family: var(--font-mono);
}

.admin-header h1 {
  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.02em;
  margin: 4px 0;
}

.admin-sub {
  font-size: 12px;
  color: var(--text-muted);
}

.admin-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  min-height: 600px;
}

@media (max-width: 700px) {
  .admin-layout { grid-template-columns: 1fr; }
}

.panel {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
}

.panel-title {
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  font-family: var(--font-mono);
}

.load-sample-btn {
  background: none;
  border: 1px solid var(--border);
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 10px;
  padding: 4px 10px;
  border-radius: 3px;
  cursor: pointer;
  transition: all var(--transition);
}
.load-sample-btn:hover {
  border-color: var(--accent-2);
  color: var(--accent-2);
}

.latex-area {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 11px;
  padding: 1rem;
  resize: none;
  line-height: 1.6;
  min-height: 480px;
}

.latex-area::placeholder { color: var(--text-dim); }

.panel-footer {
  padding: 12px 16px;
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 1rem;
}

.parse-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--accent);
  color: #000;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  padding: 8px 16px;
  border: none;
  border-radius: var(--radius);
  cursor: pointer;
  letter-spacing: 0.05em;
  transition: all var(--transition);
  text-transform: uppercase;
}
.parse-btn:hover { background: #33ebff; }

.parse-arrow { transition: transform var(--transition); }
.parse-btn:hover .parse-arrow { transform: translateX(3px); }

.parse-status {
  font-size: 11px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

/* Preview */
.preview-count {
  font-size: 11px;
  color: var(--text-dim);
  font-family: var(--font-mono);
}

.preview-output {
  flex: 1;
  padding: 1rem;
  overflow-y: auto;
  font-family: var(--font-mono);
  font-size: 11px;
}

.preview-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 8px;
  color: var(--text-dim);
}

.empty-icon {
  font-size: 2rem;
  opacity: 0.3;
}

.preview-section { margin-bottom: 1.2rem; }

.preview-key {
  color: var(--accent);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.preview-value {
  color: var(--text-muted);
  line-height: 1.6;
  padding-left: 8px;
  border-left: 2px solid var(--border);
}

.preview-list-item {
  padding: 6px 0;
  border-bottom: 1px solid var(--border);
  color: var(--text-muted);
}

.preview-list-item:last-child { border-bottom: none; }

.item-title { color: var(--text); font-weight: 500; }
.item-sub { color: var(--text-dim); font-size: 10px; }
.item-tags { margin-top: 4px; display: flex; flex-wrap: wrap; gap: 4px; }
.item-tag {
  font-size: 9px;
  padding: 1px 6px;
  border: 1px solid var(--border);
  border-radius: 2px;
  color: var(--text-dim);
}

.parse-ok { color: #00ff9d; }
.parse-err { color: #ff4d6d; }
</style>

<script>
function parseLatexCV(tex: string) {
  // Strip comments and normalize
  const clean = tex.replace(/%.*$/gm, '').replace(/\r\n/g, '\n').trim();

  const result: Record<string, unknown> = {};

  // Name
  const nameMatch = clean.match(/\\textbf\{\\Huge\s+\\scshape\s+([^}]+)\}/);
  result.name = nameMatch ? nameMatch[1].trim() : '';

  // Email
  const emailMatch = clean.match(/\\href\{mailto:([^}]+)\}/);
  result.email = emailMatch ? emailMatch[1].trim() : '';

  // LinkedIn
  const liMatch = clean.match(/\\href\{(https?:\/\/[^}]*linkedin[^}]*)\}/);
  result.linkedin = liMatch ? liMatch[1].trim() : '';

  // Summary
  const summaryMatch = clean.match(/\\section\*\{Summary\}([\s\S]*?)\\section/);
  if (summaryMatch) {
    result.summary = summaryMatch[1]
      .replace(/\\small\{?/g, '').replace(/\}?\s*$/g, '')
      .replace(/\\textbf\{([^}]*)\}/g, '$1')
      .replace(/\n+/g, ' ').trim();
  }

  // Skills - extract from itemize
  const skillsMatch = clean.match(/\\section\{Technical Skills\}([\s\S]*?)\\section/);
  const skills: { category: string; items: string[] }[] = [];
  if (skillsMatch) {
    const skillBlock = skillsMatch[1];
    const groups = skillBlock.matchAll(/\\textbf\{([^}]+)\}\{:\s*([^\\]+)\}/g);
    for (const g of groups) {
      const cat = g[1].trim();
      const items = g[2].split(',').map(s =>
        s.replace(/\\textbf\{([^}]*)\}/g, '$1').trim()
      ).filter(Boolean);
      if (cat && items.length) skills.push({ category: cat, items });
    }
  }
  result.skills = skills;

  // Education
  const eduMatch = clean.match(/\\section\{Education\}([\s\S]*?)\\section/);
  const education: unknown[] = [];
  if (eduMatch) {
    const entries = [...eduMatch[1].matchAll(/\\resumeSubheading\s*\{([^}]*)\}\{([^}]*)\}\s*\{([^}]*)\}\{([^}]*)\}/g)];
    entries.forEach(e => {
      const bullets: string[] = [];
      const bulletSection = eduMatch[1].slice(e.index!);
      const bulletsMatch = [...bulletSection.matchAll(/\\resumeItem\{([^}]+)\}/g)].slice(0, 5);
      bulletsMatch.forEach(b => bullets.push(b[1].replace(/\\textbf\{([^}]*)\}/g, '$1').trim()));
      education.push({
        institution: e[1].trim(),
        dates: e[2].trim(),
        degree: e[3].trim(),
        location: e[4].trim(),
        bullets,
      });
    });
  }
  result.education = education;

  // Experience
  const expMatch = clean.match(/\\section\{Professional Experience\}([\s\S]*?)\\section/);
  const experience: unknown[] = [];
  if (expMatch) {
    const block = expMatch[1];
    const entries = [...block.matchAll(/\\resumeSubheading\s*\{([^}]*)\}\{([^}]*)\}\s*\{([^}]*)\}\{([^}]*)\}/g)];
    entries.forEach((e, idx) => {
      const start = e.index!;
      const end = entries[idx + 1]?.index ?? block.length;
      const chunk = block.slice(start, end);
      const bullets: string[] = [];
      const bm = [...chunk.matchAll(/\\resumeItem\{([^}]+)\}/g)];
      bm.forEach(b => bullets.push(b[1].replace(/\\textbf\{([^}]*)\}/g, '$1').trim()));

      const roleRaw = e[3];
      const techMatch = roleRaw.match(/\$\|\$\s*\\textbf\{([^}]*)\}(?:,\s*\\textbf\{([^}]*)\})*/) ||
                        roleRaw.match(/\\textbf\{([^}]+)\}/g);
      const tech = techMatch
        ? roleRaw.match(/\\textbf\{([^}]+)\}/g)?.map(t => t.replace(/\\textbf\{|\}/g, '')) ?? []
        : [];

      experience.push({
        company: e[1].trim(),
        location: e[2].trim(),
        role: roleRaw.replace(/\$\|\$.*/, '').replace(/\\textbf\{([^}]*)\}/g, '$1').trim(),
        dates: e[4].trim(),
        tech,
        bullets,
      });
    });
  }
  result.experience = experience;

  // Projects
  const projMatch = clean.match(/\\section\{Technical Projects\}([\s\S]*?)\\end\{document\}/);
  const projects: unknown[] = [];
  if (projMatch) {
    const block = projMatch[1];
    const entries = [...block.matchAll(/\\resumeSubheading\s*\{([^}]*)\}\{([^}]*)\}\s*\{([^}]*)\}\{([^}]*)\}/g)];
    entries.forEach((e, idx) => {
      const start = e.index!;
      const end = entries[idx + 1]?.index ?? block.length;
      const chunk = block.slice(start, end);
      const bullets: string[] = [];
      const bm = [...chunk.matchAll(/\\resumeItem\{([^}]+)\}/g)];
      bm.forEach(b => bullets.push(b[1].replace(/\\textbf\{([^}]*)\}/g, '$1').trim()));
      const tech = e[3].match(/\\textbf\{([^}]+)\}/g)?.map(t => t.replace(/\\textbf\{|\}/g, '')) ?? [];
      projects.push({
        name: e[1].trim(),
        location: e[2].trim(),
        role: e[3].replace(/\\textbf\{([^}]*)\}/g, '$1').split('$|$')[0].trim(),
        dates: e[4].trim(),
        tech,
        bullets,
      });
    });
  }
  result.projects = projects;

  return result;
}

function renderPreview(data: Record<string, unknown>) {
  const out = document.getElementById('preview-output')!;
  const count = document.getElementById('field-count')!;

  let html = '';

  if (data.name) {
    html += `<div class="preview-section">
      <div class="preview-key">name</div>
      <div class="preview-value">${data.name}</div>
    </div>`;
  }
  if (data.email) {
    html += `<div class="preview-section">
      <div class="preview-key">email</div>
      <div class="preview-value">${data.email}</div>
    </div>`;
  }

  const skills = data.skills as { category: string; items: string[] }[] | undefined;
  if (skills?.length) {
    html += `<div class="preview-section">
      <div class="preview-key">skills (${skills.length} groups)</div>`;
    skills.forEach(g => {
      html += `<div class="preview-list-item">
        <div class="item-title">${g.category}</div>
        <div class="item-tags">${g.items.map(i => `<span class="item-tag">${i}</span>`).join('')}</div>
      </div>`;
    });
    html += `</div>`;
  }

  const exp = data.experience as unknown[] | undefined;
  if (exp?.length) {
    html += `<div class="preview-section">
      <div class="preview-key">experience (${exp.length} entries)</div>`;
    (exp as {role?: string; company?: string; dates?: string; tech?: string[]}[]).forEach(e => {
      html += `<div class="preview-list-item">
        <div class="item-title">${e.role || ''} @ ${e.company || ''}</div>
        <div class="item-sub">${e.dates || ''}</div>
        <div class="item-tags">${(e.tech || []).map(t => `<span class="item-tag">${t}</span>`).join('')}</div>
      </div>`;
    });
    html += `</div>`;
  }

  const proj = data.projects as unknown[] | undefined;
  if (proj?.length) {
    html += `<div class="preview-section">
      <div class="preview-key">projects (${proj.length} entries)</div>`;
    (proj as {name?: string; role?: string; dates?: string}[]).forEach(p => {
      html += `<div class="preview-list-item">
        <div class="item-title">${p.name || ''}</div>
        <div class="item-sub">${p.role || ''} · ${p.dates || ''}</div>
      </div>`;
    });
    html += `</div>`;
  }

  const totalFields = Object.values(data).filter(v => v && (Array.isArray(v) ? v.length > 0 : true)).length;
  count.textContent = `${totalFields} fields extracted`;
  out.innerHTML = html || '<div class="preview-empty"><div class="empty-icon">{ }</div><p>Nothing extracted — check your LaTeX format</p></div>';
}

document.getElementById('parse-btn')?.addEventListener('click', () => {
  const tex = (document.getElementById('latex-input') as HTMLTextAreaElement).value;
  const status = document.getElementById('parse-status')!;
  if (!tex.trim()) {
    status.textContent = '✗ paste some LaTeX first';
    status.className = 'parse-status parse-err';
    return;
  }
  try {
    const data = parseLatexCV(tex);
    renderPreview(data);
    status.textContent = '✓ parsed successfully';
    status.className = 'parse-status parse-ok';
  } catch (e) {
    status.textContent = '✗ parse error — check console';
    status.className = 'parse-status parse-err';
    console.error(e);
  }
});

document.getElementById('load-sample')?.addEventListener('click', () => {
  const sample = `\\begin{document}
\\begin{center}
    \\textbf{\\Huge \\scshape Adrian Wei} \\\\ \\vspace{1pt}
    \\href{mailto:hanningwei92@gmail.com}{\\underline{hanningwei92@gmail.com}}
\\end{center}
\\section*{Summary}
\\small{Software Engineering student specializing in Cybersecurity.}
\\section{Technical Skills}
 \\begin{itemize}
    \\small{\\item{
     \\textbf{Languages}{: \\textbf{Python}, \\textbf{JavaScript}, \\textbf{C++}}
    }}
 \\end{itemize}
\\section{Professional Experience}
  \\resumeSubHeadingListStart
    \\resumeSubheading
      {Match [Startup]}{Toronto, ON}
      {Software Developer Intern $|$ \\textbf{React Native}, \\textbf{Python}}{Jan 2024 -- Apr 2024}
      \\resumeItemListStart
        \\resumeItem{Engineered iOS interfaces.}
      \\resumeItemListEnd
  \\resumeSubHeadingListEnd
\\section{Technical Projects}
  \\resumeSubHeadingListStart
    \\resumeSubheading
      {GitNest (SACHacks)}{London, ON}
      {Lead Developer $|$ \\textbf{Python}, \\textbf{Gemini AI}}{Mar 2025}
      \\resumeItemListStart
        \\resumeItem{Built AI analytics service.}
      \\resumeItemListEnd
  \\resumeSubHeadingListEnd
\\end{document}`;
  (document.getElementById('latex-input') as HTMLTextAreaElement).value = sample;
});
</script>
