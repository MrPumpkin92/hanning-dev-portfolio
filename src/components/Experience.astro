---
import cv from '../content/cv.ts';
---
<section id="experience">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">02. experience</span>
      <div class="section-line"></div>
    </div>

    <div class="timeline">
      {cv.experience.map((exp, i) => (
        <div class={`timeline-item reveal ${exp.type === 'research' ? 'research' : ''}`}
             style={`transition-delay:${i * 0.1}s`}>
          <div class="timeline-marker">
            <div class="marker-dot"></div>
            <div class="marker-line"></div>
          </div>
          <div class="timeline-card">
            <div class="card-header">
              <div>
                <div class="exp-title">{exp.title}</div>
                <div class="exp-company">
                  {exp.type === 'research' && <span class="research-badge">research</span>}
                  {exp.company}
                  {exp.location && <span class="exp-location"> · {exp.location}</span>}
                </div>
              </div>
              <div class="exp-dates">{exp.dates}</div>
            </div>
            <div class="exp-tech">
              {exp.tech.map(t => <span class="tag">{t}</span>)}
            </div>
            <ul class="exp-bullets">
              {exp.bullets.map(b => (
                <li>
                  <span class="bullet-dot">▸</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
#experience { padding: 6rem 0; }

.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-item {
  display: grid;
  grid-template-columns: 24px 1fr;
  gap: 1.5rem;
}

.timeline-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 18px;
}

.marker-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: 1px solid var(--accent);
  background: var(--bg);
  flex-shrink: 0;
  transition: background var(--transition);
  position: relative;
  z-index: 1;
}

.timeline-item.research .marker-dot {
  border-color: var(--accent-2);
}

.timeline-item:hover .marker-dot {
  background: var(--accent);
  box-shadow: 0 0 10px var(--accent-glow);
}

.timeline-item.research:hover .marker-dot {
  background: var(--accent-2);
}

.marker-line {
  width: 1px;
  flex: 1;
  background: var(--border);
  margin-top: 4px;
  min-height: 40px;
}

.timeline-item:last-child .marker-line {
  display: none;
}

.timeline-card {
  padding: 1.2rem 1.5rem;
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  margin-bottom: 1.5rem;
  transition: border-color var(--transition), box-shadow var(--transition);
}

.timeline-item:hover .timeline-card {
  border-color: var(--border-bright);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
}

.timeline-item.research .timeline-card {
  border-left: 2px solid var(--accent-2);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 10px;
  flex-wrap: wrap;
}

.exp-title {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.01em;
}

.exp-company {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 2px;
}

.exp-location { color: var(--text-dim); }

.research-badge {
  display: inline-block;
  font-size: 9px;
  padding: 1px 6px;
  background: var(--accent-2-dim);
  color: var(--accent-2);
  border-radius: 2px;
  margin-right: 6px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.exp-dates {
  font-size: 11px;
  color: var(--accent);
  font-family: var(--font-mono);
  white-space: nowrap;
  flex-shrink: 0;
}

.exp-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 12px;
}

.exp-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.exp-bullets li {
  display: flex;
  gap: 8px;
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.6;
}

.bullet-dot {
  color: var(--accent);
  flex-shrink: 0;
  font-size: 10px;
  margin-top: 3px;
}

.timeline-item.research .bullet-dot {
  color: var(--accent-2);
}
</style>
