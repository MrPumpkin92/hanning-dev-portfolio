---
import cv from '../content/cv.ts';
---
<section id="hero">
  <!-- Ambient glow -->
  <div class="glow-orb glow-1"></div>
  <div class="glow-orb glow-2"></div>

  <div class="container">
    <div class="hero-content">
      <!-- Terminal window -->
      <div class="terminal reveal">
        <div class="terminal-bar">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="terminal-title">~/portfolio — bash</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="prompt">❯</span>
            <span class="cmd" id="cmd-1"></span>
          </div>
          <div class="terminal-line output" id="out-1" style="display:none">
            <span class="output-text">Adrian Wei // Software Engineer + Security Researcher</span>
          </div>
          <div class="terminal-line" id="line-2" style="display:none">
            <span class="prompt">❯</span>
            <span class="cmd" id="cmd-2"></span>
          </div>
          <div class="terminal-line output" id="out-2" style="display:none">
            <span class="output-text">University of Western Ontario · <span class="acc">ISC2 CC</span> · <span class="acc">AZ-900</span></span>
          </div>
          <div class="terminal-line" id="line-3" style="display:none">
            <span class="prompt">❯</span>
            <span class="cursor-line"><span class="cmd" id="cmd-3"></span><span class="cursor">▋</span></span>
          </div>
        </div>
      </div>

      <!-- Big name -->
      <div class="hero-name reveal" style="transition-delay:0.2s">
        <h1>
          <span class="name-line" id="glitch-name" data-text={cv.name}>{cv.name}</span>
        </h1>
        <div class="hero-subtitle">
          <span class="sub-text" id="typewriter-sub"></span>
          <span class="type-cursor">|</span>
        </div>
      </div>

      <!-- Summary -->
      <p class="hero-summary reveal" style="transition-delay:0.3s">
        {cv.summary}
      </p>

      <!-- CTA row -->
      <div class="hero-ctas reveal" style="transition-delay:0.4s">
        <a href="#experience" class="cta-primary">
          <span>view work</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href={`mailto:${cv.email}`} class="cta-secondary">{cv.email}</a>
        <a href={cv.linkedin} target="_blank" rel="noopener" class="cta-ghost">linkedin ↗</a>
      </div>

      <!-- Cert badges -->
      <div class="cert-row reveal" style="transition-delay:0.5s">
        {cv.certifications.map(cert => (
          <span class="cert-badge">{cert}</span>
        ))}
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-hint">
      <span class="scroll-line"></span>
      <span class="scroll-label">scroll</span>
    </div>
  </div>
</section>

<style>
#hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8rem 0 4rem;
  position: relative;
  overflow: hidden;
}

.glow-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
}
.glow-1 {
  width: 400px; height: 400px;
  top: -100px; right: -100px;
  background: var(--accent-2-dim);
}
.glow-2 {
  width: 300px; height: 300px;
  bottom: 0; left: -80px;
  background: var(--accent-glow);
}

.hero-content {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* Terminal */
.terminal {
  background: var(--bg-2);
  border: 1px solid var(--border-bright);
  border-radius: var(--radius-lg);
  overflow: hidden;
  max-width: 560px;
  font-size: 13px;
}

.terminal-bar {
  background: var(--surface);
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 6px;
  border-bottom: 1px solid var(--border);
}

.dot {
  width: 10px; height: 10px;
  border-radius: 50%;
}
.dot.red    { background: #ff5f57; }
.dot.yellow { background: #ffbd2e; }
.dot.green  { background: #28ca41; }

.terminal-title {
  margin-left: 8px;
  font-size: 11px;
  color: var(--text-muted);
}

.terminal-body {
  padding: 1rem 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-height: 120px;
}

.terminal-line {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.prompt { color: var(--accent); font-size: 13px; }
.cmd { color: var(--text); }
.output { padding-left: 20px; }
.output-text { color: var(--text-muted); }
.acc { color: var(--accent); }

.cursor {
  color: var(--accent);
  animation: blink 1s step-end infinite;
}
.cursor-line { display: flex; align-items: baseline; gap: 2px; }

/* Hero name */
.hero-name h1 {
  font-family: var(--font-display);
  font-size: clamp(3rem, 9vw, 5.5rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1;
  color: var(--text);
}

.name-line {
  position: relative;
  display: inline-block;
}

.name-line::before,
.name-line::after {
  content: attr(data-text);
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  opacity: 0;
}
.name-line::before { color: var(--accent); }
.name-line::after  { color: var(--accent-2); }

.name-line:hover::before {
  animation: glitch 0.4s linear infinite;
  opacity: 0.6;
  clip-path: inset(0 0 50% 0);
}
.name-line:hover::after {
  animation: glitch 0.4s linear infinite reverse;
  opacity: 0.6;
  clip-path: inset(50% 0 0 0);
}

.hero-subtitle {
  margin-top: 4px;
  font-size: 14px;
  color: var(--accent);
  letter-spacing: 0.08em;
  font-family: var(--font-mono);
  min-height: 24px;
}

.type-cursor {
  animation: blink 1s step-end infinite;
  color: var(--accent);
}

.hero-summary {
  font-size: 13px;
  color: var(--text-muted);
  max-width: 560px;
  line-height: 1.8;
}

/* CTAs */
.hero-ctas {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
}

.cta-primary {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 20px;
  background: var(--accent);
  color: #000 !important;
  font-size: 12px;
  font-family: var(--font-mono);
  font-weight: 700;
  border-radius: var(--radius);
  letter-spacing: 0.05em;
  transition: all var(--transition);
  text-transform: uppercase;
}
.cta-primary:hover {
  opacity: 1 !important;
  background: #33ebff;
  box-shadow: 0 0 20px var(--accent-glow);
}

.cta-secondary {
  font-size: 12px;
  color: var(--text-muted) !important;
  border-bottom: 1px solid var(--border);
  padding-bottom: 2px;
  letter-spacing: 0.02em;
  transition: all var(--transition) !important;
}
.cta-secondary:hover {
  color: var(--text) !important;
  border-color: var(--text-muted);
  opacity: 1 !important;
}

.cta-ghost {
  font-size: 11px;
  color: var(--text-dim) !important;
  letter-spacing: 0.05em;
  transition: color var(--transition) !important;
}
.cta-ghost:hover { color: var(--text-muted) !important; opacity: 1 !important; }

/* Cert badges */
.cert-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.cert-badge {
  font-size: 10px;
  font-family: var(--font-mono);
  padding: 4px 10px;
  border: 1px solid var(--accent-2);
  color: var(--accent-2);
  border-radius: 3px;
  background: var(--accent-2-dim);
  letter-spacing: 0.05em;
}

/* Scroll hint */
.scroll-hint {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.scroll-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, transparent, var(--accent));
  animation: scanDown 2s ease-in-out infinite;
}

.scroll-label {
  font-size: 9px;
  letter-spacing: 0.2em;
  color: var(--text-dim);
  text-transform: uppercase;
}
</style>

<script>
  // Terminal typewriter sequence
  async function typeText(el: HTMLElement, text: string, speed = 60) {
    for (const char of text) {
      el.textContent += char;
      await new Promise(r => setTimeout(r, speed));
    }
  }

  async function runTerminal() {
    await new Promise(r => setTimeout(r, 600));

    const cmd1 = document.getElementById('cmd-1')!;
    const out1 = document.getElementById('out-1')!;
    const line2 = document.getElementById('line-2')!;
    const cmd2 = document.getElementById('cmd-2')!;
    const out2 = document.getElementById('out-2')!;
    const line3 = document.getElementById('line-3')!;
    const cmd3 = document.getElementById('cmd-3')!;

    await typeText(cmd1, 'whoami', 70);
    await new Promise(r => setTimeout(r, 300));
    out1.style.display = 'flex';
    await new Promise(r => setTimeout(r, 500));

    line2.style.display = 'flex';
    await typeText(cmd2, 'cat education.txt', 60);
    await new Promise(r => setTimeout(r, 300));
    out2.style.display = 'flex';
    await new Promise(r => setTimeout(r, 500));

    line3.style.display = 'flex';
    await typeText(cmd3, 'ls ./projects/', 60);
  }

  // Subtitle typewriter
  const roles = [
    'Software Engineer',
    'Security Researcher',
    'Backend Developer',
    'Full Stack Developer',
  ];
  let ri = 0, ci = 0, deleting = false;
  const subEl = document.getElementById('typewriter-sub')!;

  function typeRole() {
    const current = roles[ri];
    if (!deleting) {
      subEl.textContent = current.slice(0, ci + 1);
      ci++;
      if (ci === current.length) {
        deleting = true;
        setTimeout(typeRole, 1800);
        return;
      }
    } else {
      subEl.textContent = current.slice(0, ci - 1);
      ci--;
      if (ci === 0) {
        deleting = false;
        ri = (ri + 1) % roles.length;
      }
    }
    setTimeout(typeRole, deleting ? 40 : 80);
  }

  document.addEventListener('DOMContentLoaded', () => {
    runTerminal();
    setTimeout(typeRole, 1000);
  });
</script>
