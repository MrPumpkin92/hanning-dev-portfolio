---
import cv from '../content/cv.ts';
---
<section id="skills">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">04. skills</span>
      <div class="section-line"></div>
    </div>

    <div class="skills-layout">
      <!-- Skill groups list -->
      <div class="skill-groups reveal">
        {cv.skills.map((group, gi) => (
          <div class="skill-group">
            <div class="group-label">{group.category}</div>
            <div class="skill-tags">
              {group.items.map(item => (
                <span class="skill-tag" data-skill={item}>{item}</span>
              ))}
            </div>
          </div>
        ))}

        <!-- Education block -->
        <div class="skill-group edu-block">
          <div class="group-label">education</div>
          {cv.education.map(edu => (
            <div class="edu-entry">
              <div class="edu-inst">{edu.institution}</div>
              <div class="edu-degree">{edu.degree}</div>
              <div class="edu-meta">{edu.location} · {edu.dates}</div>
              <ul class="edu-bullets">
                {edu.bullets.map(b => (
                  <li><span class="bullet-dot">▸</span><span>{b}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Certs -->
        <div class="skill-group">
          <div class="group-label">certifications</div>
          {cv.certifications.map(cert => (
            <div class="cert-item">
              <span class="cert-check">✓</span>
              {cert}
            </div>
          ))}
        </div>
      </div>

      <!-- Bubble canvas -->
      <div class="bubble-container reveal" style="transition-delay:0.2s">
        <canvas id="skills-canvas"></canvas>
        <div class="canvas-label">hover to explore</div>
      </div>
    </div>
  </div>
</section>

<style>
#skills { padding: 6rem 0; }

.skills-layout {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 3rem;
  align-items: start;
}

@media (max-width: 720px) {
  .skills-layout { grid-template-columns: 1fr; }
  .bubble-container { order: -1; }
}

.skill-groups {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.skill-group {}
.group-label {
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 10px;
  font-family: var(--font-mono);
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.skill-tag {
  font-size: 11px;
  font-family: var(--font-mono);
  padding: 4px 10px;
  border: 1px solid var(--border);
  color: var(--text-muted);
  background: var(--bg-2);
  border-radius: 3px;
  cursor: default;
  transition: all var(--transition);
}

.skill-tag:hover, .skill-tag.active {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-dim);
}

/* Education */
.edu-block {}
.edu-entry {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-left: 2px solid var(--accent);
  border-radius: var(--radius);
  padding: 1rem 1.2rem;
}

.edu-inst {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text);
}

.edu-degree {
  font-size: 12px;
  color: var(--accent);
  margin: 2px 0;
}

.edu-meta {
  font-size: 11px;
  color: var(--text-dim);
  margin-bottom: 10px;
}

.edu-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.edu-bullets li {
  display: flex;
  gap: 6px;
  font-size: 11px;
  color: var(--text-muted);
  line-height: 1.5;
}

.bullet-dot {
  color: var(--accent);
  flex-shrink: 0;
  font-size: 9px;
  margin-top: 3px;
}

/* Certs */
.cert-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--text-muted);
  padding: 6px 0;
  border-bottom: 1px solid var(--border);
}

.cert-item:last-child { border-bottom: none; }

.cert-check {
  color: var(--green);
  font-size: 12px;
}

/* Bubble canvas */
.bubble-container {
  position: sticky;
  top: 6rem;
}

#skills-canvas {
  width: 100%;
  height: 340px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--bg-2);
  cursor: crosshair;
}

.canvas-label {
  text-align: center;
  font-size: 10px;
  color: var(--text-dim);
  margin-top: 8px;
  letter-spacing: 0.1em;
}
</style>

<script>
  // Skills bubble chart
  const canvas = document.getElementById('skills-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  const allSkills = JSON.parse(document.getElementById('skills-data')?.textContent || '[]');

  interface Bubble {
    x: number; y: number;
    vx: number; vy: number;
    r: number;
    label: string;
    color: string;
    alpha: number;
    targetAlpha: number;
  }

  const colors = ['#00e5ff', '#7c3aed', '#00ff9d', '#ff4d6d'];
  const colorMap: Record<string, string> = {
    'Python': '#00e5ff', 'C++': '#00e5ff', 'C#': '#00e5ff',
    'JavaScript': '#7c3aed', 'TypeScript': '#7c3aed',
    'ML': '#00ff9d', 'TensorFlow': '#00ff9d',
    'Wireshark': '#ff4d6d', 'Linux': '#ff4d6d', 'Docker': '#ff4d6d',
  };

  let bubbles: Bubble[] = [];
  let mx = -999, my = -999;
  let W = 0, H = 0;

  function initBubbles() {
    W = canvas.offsetWidth;
    H = canvas.offsetHeight;
    canvas.width = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    ctx.scale(devicePixelRatio, devicePixelRatio);

    bubbles = allSkills.map((skill: string) => ({
      x: Math.random() * (W - 80) + 40,
      y: Math.random() * (H - 80) + 40,
      vx: (Math.random() - 0.5) * 0.4,
      vy: (Math.random() - 0.5) * 0.4,
      r: Math.random() * 10 + 20,
      label: skill,
      color: colorMap[skill] || colors[Math.floor(Math.random() * colors.length)],
      alpha: 0.6,
      targetAlpha: 0.6,
    }));
  }

  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mx = e.clientX - rect.left;
    my = e.clientY - rect.top;
  });

  canvas.addEventListener('mouseleave', () => { mx = -999; my = -999; });

  function draw() {
    ctx.clearRect(0, 0, W, H);

    bubbles.forEach(b => {
      // Repel from cursor
      const dx = b.x - mx, dy = b.y - my;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 80) {
        b.vx += (dx / dist) * 0.5;
        b.vy += (dy / dist) * 0.5;
        b.targetAlpha = 1;
      } else {
        b.targetAlpha = 0.5;
      }

      b.alpha += (b.targetAlpha - b.alpha) * 0.1;

      // Move
      b.x += b.vx;
      b.y += b.vy;
      b.vx *= 0.98;
      b.vy *= 0.98;

      // Bounce
      if (b.x - b.r < 0) { b.x = b.r; b.vx *= -1; }
      if (b.x + b.r > W) { b.x = W - b.r; b.vx *= -1; }
      if (b.y - b.r < 0) { b.y = b.r; b.vy *= -1; }
      if (b.y + b.r > H) { b.y = H - b.r; b.vy *= -1; }

      // Draw bubble
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
      ctx.strokeStyle = b.color + Math.round(b.alpha * 255).toString(16).padStart(2, '0');
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.fillStyle = b.color + Math.round(b.alpha * 0.12 * 255).toString(16).padStart(2, '0');
      ctx.fill();

      // Label
      ctx.fillStyle = b.color + Math.round(b.alpha * 255).toString(16).padStart(2, '0');
      ctx.font = `${Math.max(8, b.r * 0.45)}px JetBrains Mono, monospace`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(b.label.length > 8 ? b.label.slice(0, 7) + '.' : b.label, b.x, b.y);
    });

    requestAnimationFrame(draw);
  }

  // Sync hover on skill tags
  document.querySelectorAll<HTMLElement>('.skill-tag').forEach(tag => {
    tag.addEventListener('mouseenter', () => {
      const skill = tag.getAttribute('data-skill');
      const bubble = bubbles.find(b => b.label === skill);
      if (bubble) {
        bubble.vx += (Math.random() - 0.5) * 2;
        bubble.vy += (Math.random() - 0.5) * 2;
        bubble.targetAlpha = 1;
      }
    });
  });

  initBubbles();
  draw();

  window.addEventListener('resize', initBubbles);
</script>

<script id="skills-data" type="application/json" set:text={JSON.stringify(
  cv.skills.flatMap(g => g.items)
)}></script>
