---
import cv from '../content/cv.ts';
---
<section id="projects">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">03. projects</span>
      <div class="section-line"></div>
    </div>

    <!-- Filter tabs -->
    <div class="filter-tabs reveal">
      <button class="filter-btn active" data-filter="all">all</button>
      <button class="filter-btn" data-filter="security">security</button>
      <button class="filter-btn" data-filter="fullstack">full stack</button>
      <button class="filter-btn" data-filter="data">data / ml</button>
    </div>

    <div class="projects-grid">
      {cv.projects.map((proj, i) => {
        const categories = (() => {
          const techLower = proj.tech.join(' ').toLowerCase() + proj.name.toLowerCase();
          const cats = ['all'];
          if (techLower.includes('ml') || techLower.includes('tensorflow') || techLower.includes('python') && (techLower.includes('analytics') || techLower.includes('nba') || techLower.includes('gemini'))) cats.push('data');
          if (techLower.includes('owasp') || techLower.includes('dns') || techLower.includes('mininet') || techLower.includes('wireshark') || techLower.includes('secure') || proj.name.toLowerCase().includes('secure') || proj.name.toLowerCase().includes('leak')) cats.push('security');
          if (techLower.includes('angular') || techLower.includes('express') || techLower.includes('node') || techLower.includes('react') || techLower.includes('django') || techLower.includes('.net')) cats.push('fullstack');
          return cats.join(' ');
        })();

        return (
          <div class="project-card reveal"
               data-categories={categories}
               data-index={i}
               style={`transition-delay:${(i % 3) * 0.08}s`}>
            <div class="card-top">
              <div class="proj-meta">
                <span class="proj-dates">{proj.dates}</span>
                {proj.location && <span class="proj-loc">{proj.location}</span>}
              </div>
              <div class="proj-corner">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7v10"/>
                </svg>
              </div>
            </div>
            <h3 class="proj-name">{proj.name}</h3>
            <p class="proj-role">{proj.role}</p>
            <p class="proj-preview">{proj.bullets[0]}</p>
            <div class="proj-tech">
              {proj.tech.slice(0, 4).map(t => <span class="tag">{t}</span>)}
              {proj.tech.length > 4 && <span class="tag tag-more">+{proj.tech.length - 4}</span>}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- Modal -->
<div id="project-modal" class="modal-overlay" aria-hidden="true">
  <div class="modal-box">
    <button class="modal-close" id="modal-close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <div id="modal-content"></div>
  </div>
</div>

<style>
#projects { padding: 6rem 0; }

.filter-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 2.5rem;
  flex-wrap: wrap;
}

.filter-btn {
  background: none;
  border: 1px solid var(--border);
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 11px;
  padding: 6px 14px;
  border-radius: 3px;
  cursor: pointer;
  transition: all var(--transition);
  letter-spacing: 0.05em;
}

.filter-btn:hover, .filter-btn.active {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-dim);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1rem;
}

.project-card {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.4rem;
  cursor: pointer;
  transition: all var(--transition);
  display: flex;
  flex-direction: column;
  gap: 8px;
  position: relative;
  overflow: hidden;
}

.project-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--accent-dim) 0%, transparent 60%);
  opacity: 0;
  transition: opacity var(--transition);
}

.project-card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
}

.project-card:hover::before { opacity: 1; }

.project-card.hidden {
  display: none;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.proj-meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.proj-dates {
  font-size: 10px;
  color: var(--accent);
  font-family: var(--font-mono);
}

.proj-loc {
  font-size: 10px;
  color: var(--text-dim);
}

.proj-corner {
  color: var(--text-dim);
  transition: color var(--transition);
}
.project-card:hover .proj-corner { color: var(--accent); }

.proj-name {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.02em;
}

.proj-role {
  font-size: 11px;
  color: var(--accent-2);
  letter-spacing: 0.05em;
}

.proj-preview {
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.6;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.proj-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 4px;
}

.tag-more {
  color: var(--text-dim);
}

/* Modal */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  backdrop-filter: blur(4px);
}

.modal-overlay.open {
  opacity: 1;
  pointer-events: all;
}

.modal-box {
  background: var(--bg-2);
  border: 1px solid var(--border-bright);
  border-radius: var(--radius-lg);
  padding: 2rem;
  max-width: 560px;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  position: relative;
  transform: translateY(12px);
  transition: transform 0.2s ease;
}

.modal-overlay.open .modal-box { transform: translateY(0); }

.modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: none;
  border: 1px solid var(--border);
  color: var(--text-muted);
  cursor: pointer;
  padding: 6px;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  transition: all var(--transition);
}
.modal-close:hover {
  border-color: var(--red);
  color: var(--red);
}

.modal-title {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.02em;
  margin-bottom: 4px;
  padding-right: 2rem;
}

.modal-role {
  font-size: 12px;
  color: var(--accent-2);
  letter-spacing: 0.05em;
  margin-bottom: 4px;
}

.modal-meta {
  font-size: 11px;
  color: var(--text-dim);
  margin-bottom: 1rem;
}

.modal-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 1.2rem;
}

.modal-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.modal-bullets li {
  display: flex;
  gap: 8px;
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.6;
}

.modal-bullets .bullet-dot {
  color: var(--accent);
  flex-shrink: 0;
  font-size: 10px;
  margin-top: 3px;
}
</style>

<script>
  // Filter logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.getAttribute('data-filter')!;
      cards.forEach(card => {
        const cats = card.getAttribute('data-categories') || '';
        card.classList.toggle('hidden', !cats.includes(filter));
      });
    });
  });

  // Modal logic
  const modal = document.getElementById('project-modal')!;
  const modalContent = document.getElementById('modal-content')!;
  const closeBtn = document.getElementById('modal-close')!;

  const projects = JSON.parse(document.getElementById('projects-data')?.textContent || '[]');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const idx = parseInt(card.getAttribute('data-index') || '0');
      const proj = projects[idx];
      if (!proj) return;

      modalContent.innerHTML = `
        <div class="modal-title">${proj.name}</div>
        <div class="modal-role">${proj.role}</div>
        <div class="modal-meta">${proj.dates}${proj.location ? ' · ' + proj.location : ''}</div>
        <div class="modal-tech">${proj.tech.map((t: string) => `<span class="tag">${t}</span>`).join('')}</div>
        <ul class="modal-bullets">
          ${proj.bullets.map((b: string) => `<li><span class="bullet-dot">▸</span><span>${b}</span></li>`).join('')}
        </ul>
      `;
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
    });
  });

  closeBtn.addEventListener('click', () => {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
  });

  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
    }
  });
</script>

<!-- Pass data to script -->
<script id="projects-data" type="application/json" set:text={JSON.stringify(cv.projects)}></script>
